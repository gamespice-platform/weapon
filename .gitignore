# Godot 4
.godot/
.import/
/android/

# gs-core and gs-combat are separate repositories. For local development, symlink them:
#   ln -s ../../gs-core/addons/gs_core addons/gs_core
#   ln -s ../../gs-combat/addons/gs_combat addons/gs_combat
# Consumers copy all three addons into their own project.
/addons/gs_core
/addons/gs_profile
/addons/gs_combat
# gs-sim (optional): its native GSSimWeaponSpread runs the hitscan spread tick when present.
/addons/gs_sim

